[Unit]
Description=gateway deploy webhook (adnanh/webhook)
After=network-online.target docker.service
Wants=network-online.target

[Service]
# DEPLOY_KEY_DOGROO / DEPLOY_KEY_DONOTI (hooks.json의 getenv 템플릿이 참조)
EnvironmentFile=/etc/gateway/deploy.env
# -urlprefix deploy + 훅 id → 경로가 /deploy/dogroo, /deploy/donoti (gateway Caddyfile의 rewrite와 일치)
ExecStart=/usr/local/bin/webhook -hooks /root/workspace/dogroo/gateway/hooks.json -template -ip 0.0.0.0 -port 9099 -urlprefix deploy
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
